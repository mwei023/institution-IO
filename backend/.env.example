# ─── Server ────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=debug            # debug | info | warn | error

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgres://iosuser:iospassword_dev@localhost:5432/institution_os?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:iosredis_dev@localhost:6379/0

# ─── JWT (generate with: openssl genrsa -out jwt_private.pem 2048) ─
JWT_PRIVATE_KEY_PATH=./jwt_private.pem
JWT_PUBLIC_KEY_PATH=./jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── Encryption (32 random bytes as hex, 64 chars) ─────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_64_character_hex_key_here_replace_me_000000000000000000000000

# ─── Object Storage (MinIO / S3) ───────────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=institution-os
STORAGE_USE_SSL=false

# ─── M-Pesa Daraja ─────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox    # sandbox | production
MPESA_CONSUMER_KEY=          # from developer.safaricom.co.ke
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379       # sandbox test shortcode
MPESA_PASSKEY=               # from Safaricom dashboard
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/finance/mpesa/callback
MPESA_CALLBACK_SECRET=         # pilot P0-3: shared secret Daraja must send as X-Callback-Secret; required in production

# ─── SMS (Africa's Talking) ────────────────────────────────────────
SMS_API_KEY=                 # leave empty for stub mode
SMS_USERNAME=sandbox
SMS_SENDER_ID=InstitutionOS

# ─── Email (SendGrid) ──────────────────────────────────────────────
SENDGRID_API_KEY=            # leave empty for stub mode
EMAIL_FROM_ADDRESS=noreply@upendo.ac.ke
EMAIL_FROM_NAME=Upendo Secondary School

# ─── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Backup ────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=       # openssl rand -hex 32
BACKUP_BUCKET=institution-os-backups
